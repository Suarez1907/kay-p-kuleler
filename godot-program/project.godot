; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kayıp Kuleler"
config/description="Monument Valley ve Mekorama'dan esinlenen 3B programlama bulmacası"
config/version="3.5.0"
run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.8", "Mobile")
config/icon="res://icon.png"

[audio]

general/text_to_speech=true

[autoload]

AudioHaptics="*res://scripts/audio/audio_haptics_manager.gd"
ASMR="*res://scripts/audio/asmr_music_engine.gd"
PerformanceManager="*res://scripts/perf/performance_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/kk_lightmap_baker/plugin.cfg")

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.android="vulkan"
shader_compiler/shader_cache/enabled=true
shader_compiler/shader_cache/use_zstd_compression=true
viewport/scaling_3d_mode=1
viewport/scaling_3d_scale=1.0
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=false
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_3d=1
